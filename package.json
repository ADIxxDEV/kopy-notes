{
  "name": "kopy-notes",
  "version": "0.2.0-dev.1",
  "private": true,
  "type": "module",
  "license": "MIT",
  "description": "An offline-first, customizable teaching whiteboard",
  "main": "desktop/main.cjs",
  "scripts": {
    "dev": "vite --configLoader native --host 127.0.0.1",
    "build": "tsc --noEmit && vite build --configLoader native",
    "preview": "vite preview --configLoader native --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test --test-isolation=none test/*.test.ts",
    "desktop": "electron desktop/main.cjs",
    "desktop:build": "npm run build && electron-builder --win nsis --publish never",
    "android:sync": "npm run build && cap sync android",
    "android:add": "cap add android",
    "check:privacy": "node scripts/check-privacy.mjs",
    "check:release": "node scripts/check-release.mjs"
  },
  "dependencies": {
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "idb": "8.0.3",
    "jszip": "3.10.2",
    "jspdf": "4.2.1",
    "mammoth": "1.13.0",
    "pdfjs-dist": "6.3.289",
    "dompurify": "3.4.16",
    "mathjs": "15.2.0",
    "@capacitor/core": "8.5.2",
    "@capacitor/android": "8.5.2",
    "html2canvas": "1.4.1"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "typescript": "5.9.3",
    "vite": "8.3.2",
    "@vitejs/plugin-react": "6.1.1",
    "@tailwindcss/vite": "4.3.3",
    "tailwindcss": "4.3.3",
    "vite-plugin-pwa": "1.3.0",
    "electron": "44.5.1",
    "electron-builder": "26.15.3",
    "@capacitor/cli": "8.5.2",
    "fake-indexeddb": "6.2.5",
    "tsx": "4.23.15",
    "@playwright/test": "1.63.0"
  },
  "build": {
    "appId": "org.kopynotes.app",
    "productName": "Kopy Notes",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "desktop/**/*",
      "package.json",
      "LICENSE",
      "THIRD_PARTY.md"
    ],
    "win": {
      "icon": "branding/icon.ico",
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
